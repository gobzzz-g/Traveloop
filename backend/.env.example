# =====================================================
# TRAVELOOP BACKEND - Environment Variables
# Copy this file to .env and fill in the values
# =====================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/traveloop"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-token-secret-different-from-jwt"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
API_PREFIX="/api"

# Google OAuth (optional - for Google Sign-In)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AI - Google Gemini
GEMINI_API_KEY="your-gemini-api-key-from-aistudio.google.com"

# Email (optional - for verification emails)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="Traveloop <noreply@traveloop.com>"

# External APIs (all optional with fallbacks)
GEODB_API_KEY="your-rapidapi-geodb-key"
UNSPLASH_ACCESS_KEY="your-unsplash-access-key"
OPENWEATHER_API_KEY="your-openweather-api-key"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=10

# Session Secret (for cookie sessions)
SESSION_SECRET="your-session-secret-min-32-chars"
